## Ejemplo de .env para backend FastAPI
# Si usás autenticación SQL Server (SQL Login) completa:
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost\\SQLEXPRESS
DB_NAME=PrendeteRock
DB_UID=
DB_PWD=
# Si preferís usar Trusted Connection (Windows Authentication), dejá DB_UID y DB_PWD vacíos
TRUSTED_CONNECTION=yes

# Puerto donde correrá FastAPI
PORT=8000
