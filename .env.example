# ============================================================
# AI Print Studio — Variables de entorno
# Copiar este archivo como .env y completar los valores reales
# NUNCA commitear el archivo .env
# ============================================================

# Base de datos
DB_PATH=./backend/db/aiprint.db

# Stability AI (generación de imágenes)
STABILITY_API_KEY=tu_stability_api_key_aqui

# OpenAI (alternativa a Stability AI)
OPENAI_API_KEY=tu_openai_api_key_aqui

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_aqui

# MercadoPago back_urls (donde redirige tras el pago)
MP_URL_SUCCESS=http://localhost:5173/success
MP_URL_FAILURE=http://localhost:5173/failure
MP_URL_PENDING=http://localhost:5173/pending

# Entorno (development | production)
APP_ENV=development

# CORS — orígenes permitidos en producción (separados por coma)
# Ejemplo: https://prendeterock.com,https://www.prendeterock.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT — clave secreta para firmar tokens (¡cambiala en producción!)
# Generá una clave segura con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga_y_aleatoria
