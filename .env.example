# ============================================================
# AI Print Studio — Variables de entorno
# Copiar este archivo como .env y completar los valores reales
# NUNCA commitear el archivo .env
# ============================================================

# ── FRONTEND ──────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_API_PORT=8000

# ── BACKEND FASTAPI (Python - PRINCIPAL) ──────────────────
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
FASTAPI_RELOAD=true

# ── BACKEND PHP (deprecado - transición) ──────────────────
PHP_HOST=127.0.0.1
PHP_PORT=8080

# ── BACKEND NODE (para imágenes) ───────────────────────────
NODE_HOST=127.0.0.1
NODE_PORT=3000

# ── BASE DE DATOS - PostgreSQL (NUEVA) ────────────────────
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=PrendeteRock
PG_USER=postgres
PG_PASSWORD=Pasteldepapas123#
PG_SSL=false

# ── AGENTES IA (Ollama) ────────────────────────────────────
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ── APIs EXTERNAS ─────────────────────────────────────────
STABILITY_API_KEY=tu_stability_api_key_aqui
OPENAI_API_KEY=tu_openai_api_key_aqui
REMOVE_BG_API_KEY=tu_removebg_api_key_aqui

# ── MERCADO PAGO ───────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_aqui
MP_URL_SUCCESS=http://localhost:5173/success
MP_URL_FAILURE=http://localhost:5173/failure
MP_URL_PENDING=http://localhost:5173/pending

# ── ENTORNO ────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# ── CORS - Orígenes permitidos ────────────────────────────
# Local: http://localhost:5173,http://localhost:3000
# Producción: https://prendeterock.com,https://www.prendeterock.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── JWT - Clave secreta (CAMBIAR EN PRODUCCIÓN) ──────────
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga_y_aleatoria
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ── LOGGING ────────────────────────────────────────────────
LOG_FORMAT=json
LOG_FILE=./logs/app.log
